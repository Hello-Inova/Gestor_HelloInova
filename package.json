{
  "name": "helloinova-manager",
  "version": "1.0.0",
  "description": "Sistema de gestao de sistemas - Hello Inova",
  "private": true,
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "test": "node --test --test-isolation=none",
    "build:webgl": "esbuild scripts/public-sites-3d.entry.js --bundle --format=iife --minify --outfile=public/public-sites-3d.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "three": "^0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  }
}
