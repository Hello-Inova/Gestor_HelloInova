# Copie este arquivo para ".env" (que não é versionado no Git) e preencha
# com os valores reais. Nunca coloque segredos de verdade neste arquivo
# de exemplo nem em nenhum arquivo commitado no repositório.

# String de conexão do Postgres (ex: postgres://usuario:senha@host:5432/banco).
# Na Vercel, ao adicionar um banco Postgres pela aba "Storage" do projeto
# (ex: integração com Neon), essa variável é injetada automaticamente — não
# precisa preencher manualmente lá. Em desenvolvimento local, aponte para um
# Postgres local ou para o mesmo banco hospedado usado em produção.
DATABASE_URL=

# Segredo usado para assinar os tokens de sessão (JWT). Troque em produção.
JWT_SECRET=

# Chave usada para criptografar (AES-256-GCM) as senhas dos sistemas
# cadastrados no Gestor de Sistemas. Precisa ter exatamente 64 caracteres
# hexadecimais (32 bytes). Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obrigatória em produção (Vercel) — lá o disco é somente leitura, então não
# dá para gerar e guardar a chave em arquivo automaticamente. Em
# desenvolvimento local, se deixar em branco, uma chave é gerada e salva em
# ./data/.secret_key na primeira execução.
SYSTEMS_ENC_KEY=

# Chave de API do Resend (https://resend.com/api-keys), usada para enviar
# os códigos de verificação de cadastro e login por e-mail.
RESEND_API_KEY=

# E-mail remetente dos códigos de verificação. Precisa ser de um domínio
# verificado na sua conta Resend (https://resend.com/domains). Enquanto
# isso, pode usar o remetente de testes "onboarding@resend.dev" — mas ele
# só entrega para o e-mail cadastrado na própria conta Resend.
RESEND_FROM_EMAIL=naoresponda@emails.helloconecta.com.br

# Nome de exibição do remetente nos e-mails enviados.
RESEND_FROM_NAME=Hello Inova
